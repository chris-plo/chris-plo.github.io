---
const {
  title,
  subtitle = "",
  rating = "★★★★◐",
  reviewCount = "",
  bought = "",
  extraLine = "",
} = Astro.props;
---

<div class="blurred-title" aria-hidden="true">
  <h2>{title}</h2>
  {subtitle && <p class="recipe-subtitle">{subtitle}</p>}
</div>
<slot name="after-title" />
<div class="blurred-details" aria-hidden="true">
  <p class="recipe-rating"><span>{rating}</span>{reviewCount && <span class="review-count">({reviewCount})</span>}</p>
  {bought && <p class="recipe-bought">{bought}</p>}
  {extraLine && <p class="recipe-bought">{extraLine}</p>}
  <button class="recipe-cart" type="button" tabindex="-1">Add to cart</button>
</div>

<style>
  .blurred-title,.blurred-details { filter:grayscale(1) blur(5px) !important; opacity:.58; user-select:none; pointer-events:none; }
  h2 { display:-webkit-box; overflow:hidden; margin:0; color:#666; -webkit-line-clamp:2; -webkit-box-orient:vertical; font:400 20px/1.38 Arial,sans-serif; }
  .recipe-subtitle { display:-webkit-box; overflow:hidden; margin:3px 0 8px; -webkit-line-clamp:1; -webkit-box-orient:vertical; color:#666; font:19px/1.35 Arial,sans-serif; }
  .recipe-rating { margin:5px 0 0; white-space:nowrap; color:#0f1111; font:17px/1.4 Arial,sans-serif; }
  .recipe-rating > span:first-child { color:#f56600; letter-spacing:-2px; }
  .review-count { padding-left:5px; color:#666; letter-spacing:0; }
  .recipe-bought { margin:0; color:#555; font:16px/1.4 Arial,sans-serif; }
  .recipe-cart { width:100%; min-height:48px; margin-top:18px; border:0; border-radius:28px; background:#ffd814; color:#0f1111; font:20px Arial,sans-serif; }
</style>
