---
const links = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/#engineering", label: "Engineering" },
  { href: "/journal", label: "Journal" },
  { href: "/personal", label: "Personal" }
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Chris Plössl home">cp<span>.</span></a>
  <div class="header-right">
    <nav aria-label="Main navigation">
      {links.map((link) => {
        const isCurrentPage = !link.href.includes("#") && (path === link.href || (link.href !== "/" && path.startsWith(link.href)));
        return <a href={link.href} class:list={{ active: isCurrentPage }} aria-current={isCurrentPage ? "page" : undefined}>{link.label}</a>;
      })}
    </nav>
    <div class="connect-links" aria-label="Connect">
      <a href="https://www.linkedin.com/in/christoph-pl" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href="mailto:christoph.ploessl@gmail.com">Email <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>
