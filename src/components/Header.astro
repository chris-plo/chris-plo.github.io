---
const links = [
  { href: "/", label: "Home" },
  { href: "/journal", label: "Journal" },
  { href: "/personal", label: "Personal" }
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Chris Plössl home">cp<span>.</span></a>
  <nav aria-label="Main navigation">
    {links.map((link) => {
      const isCurrentPage = !link.href.includes("#") && (path === link.href || (link.href !== "/" && path.startsWith(link.href)));
      return <a href={link.href} class:list={{ active: isCurrentPage }} aria-current={isCurrentPage ? "page" : undefined}>{link.label}</a>;
    })}
  </nav>
</header>
