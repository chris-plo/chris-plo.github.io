---
import { senderFormId, senderEmbedReady } from "../lib/sender";
---
<section class="newsletter-signup" aria-labelledby="newsletter-heading">
  <div class="newsletter-copy">
    <span class="eyebrow">Letters from the journal</span>
    <h2 id="newsletter-heading">Ideas are better when they travel.</h2>
    <p class="newsletter-lede">A little curiosity in your inbox. I’ll send a concise weekly note when new articles are published.</p>
  </div>
  <div class="newsletter-form-wrap">
    {senderEmbedReady ? (
      <div class="sender-form-field" data-sender-form-id={senderFormId}></div>
    ) : (
      <div class="newsletter-not-configured" role="status">
        <p>Email signup is being prepared. You can follow new writing through the <a href="/rss.xml">RSS feed</a> for now.</p>
      </div>
    )}
    <p class="newsletter-privacy">Your email is used only for new article digests. You’ll need to confirm your address before receiving them. <a href="/privacy/">Privacy details</a>. Unsubscribe anytime.</p>
  </div>
</section>

<style>
  .newsletter-signup { display: grid; grid-template-columns: minmax(0, .9fr) minmax(280px, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding: 42px; border: 1px solid var(--line); background: var(--paper-deep); }
  .newsletter-copy h2 { max-width: 500px; margin: 12px 0; font: 500 clamp(30px, 4vw, 42px)/1.08 var(--serif); letter-spacing: -.03em; }
  .newsletter-lede { max-width: 480px; margin: 0; color: var(--muted); line-height: 1.7; }
  .newsletter-form-wrap { min-width: 0; }
  .newsletter-privacy, .newsletter-not-configured { margin: 14px 0 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .newsletter-privacy a, .newsletter-not-configured a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .newsletter-not-configured p { margin: 0; }
  @media (max-width: 700px) { .newsletter-signup { grid-template-columns: 1fr; padding: 26px; } }
</style>
